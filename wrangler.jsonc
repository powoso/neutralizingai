{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "neutralizingai",
  "compatibility_date": "2025-09-27",
  "main": "worker.js",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
